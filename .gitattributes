# Normalize all text files to LF in the repository and in checkouts, so formatters and
# tests behave identically on Windows CRLF checkouts and Linux/macOS.
* text=auto eol=lf

# Byte-exact fixtures / generated binaries must never be line-ending normalized.
*.faro      -text
*.faro-wal  -text
*.bin       -text
*.dat       -text
*.png       -text
*.jpg       -text
*.gif       -text
*.ico       -text
*.zip       -text
*.gz        -text
*.pdf       -text
*.dll       -text
*.exe       -text
